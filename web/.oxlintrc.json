{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^react(-dom)?(/|$)|(^|/)(application|infrastructure|presentation)(/|$)",
                "message": "Clean architecture: the domain layer depends on nothing."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^react(-dom)?(/|$)|(^|/)(infrastructure|presentation)(/|$)",
                "message": "Clean architecture: the application layer depends only on the domain."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/infrastructure/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^react(-dom)?(/|$)|(^|/)presentation(/|$)",
                "message": "Clean architecture: infrastructure implements application ports and never touches the UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/presentation/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)infrastructure(/|$)",
                "message": "Clean architecture: the UI depends on application ports; only main.tsx picks adapters."
              }
            ]
          }
        ]
      }
    }
  ]
}
