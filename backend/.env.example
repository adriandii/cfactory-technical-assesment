# Copy to .env for local development (npm run dev:api / dev:worker / setup).
# Values match docker-compose.yml.
PORT=3000
DATABASE_URL=postgres://app:app@127.0.0.1:55432/images
REDIS_URL=redis://127.0.0.1:56379
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=images
S3_ACCESS_KEY_ID=silo-admin
S3_SECRET_ACCESS_KEY=silo-dev-password
WORKER_CONCURRENCY=1

# Integration tests run only when these are set (they use a throwaway schema / queue).
# TEST_DATABASE_URL=postgres://app:app@127.0.0.1:55432/images
# TEST_REDIS_URL=redis://127.0.0.1:56379
