{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "tsx --env-file-if-exists=.env src/main/setup.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/main/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:setup": "node dist/main/setup.js",
    "start:api": "node dist/main/api.js",
    "start:worker": "node dist/main/worker.js",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "bullmq": "^6.7.8",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.94.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  }
}
